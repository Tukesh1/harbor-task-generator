# Copy to .env and fill in. lib/env.py loads .env and OVERRIDES the ambient shell,
# so .env is the single source of truth for keys. (.env is gitignored.)

# Anthropic — generation agents (Stage 1/2/3 builder + reviewer via the Claude
# Agent SDK) AND harbor check/analyze judges (opus/sonnet).
ANTHROPIC_API_KEY=

# OpenAI — GPT-5.5 break trials (harbor codex agent).
OPENAI_API_KEY=

# OpenAI — Task QA judge (LLM + SOTA checks; [task_qa].enabled=true).
# Bridged into the QA CLI's expected env names at subprocess time.
# If blank, falls back to TASK_QA_OPENAI_API_KEY, AUTOQA_OPENAI_API_KEY, then OPENAI_API_KEY.
QA_JUDGE_OPENAI_API_KEY=

# OpenAI — AutoQA v3 judge. AutoQA is DISABLED by default; set this only if you
# re-enable [autoqa]. If blank, AutoQA falls back to OPENAI_API_KEY.
AUTOQA_OPENAI_API_KEY=

# Gemini — the Phase-C `harbor analyze` cross-model matrix runs gemini
# (gemini/gemini-3.1-pro-preview) via the terminus-2 agent (litellm) alongside gpt-5.5
# and Claude. Required for a full Stage-2/3 accept gate (see [[harbor.analyze_matrix]]
# in config/pipeline.toml). Verify with preflight --live.
GEMINI_API_KEY=
